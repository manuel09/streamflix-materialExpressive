<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_exo_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Gradient overlay background -->
    <View
        android:id="@+id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A0000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />

    <!-- ======================== TOP BAR (glass) ======================== -->
    <LinearLayout
        android:id="@+id/ll_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_player_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_exo_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_player_back"
            android:tint="#FFFFFF"
            tools:ignore="ContentDescription,UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/tv_exo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Nome del Film" />

            <TextView
                android:id="@+id/tv_exo_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#BBFFFFFF"
                android:textSize="12sp"
                tools:text="S1 E1 • Titolo Episodio" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_exo_external_player"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/exo_styled_controls_external_player"
            android:tint="#FFFFFF"
            tools:ignore="ContentDescription,UseAppTint,PrivateResource" />

    </LinearLayout>

    <!-- ======================== TORRENT INFO PANEL ======================== -->
    <LinearLayout
        android:id="@+id/ll_torrent_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_top_bar"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_torrent_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_player_torrent_chip"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/player_torrent_active"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="↓ 2.4 MB/s"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/tv_torrent_peers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_player_torrent_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            tools:text="👥 12 peers" />

        <TextView
            android:id="@+id/tv_torrent_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_player_torrent_chip"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            tools:text="⬛ 34%" />

    </LinearLayout>

    <!-- ======================== CENTER CONTROLS ======================== -->
    <LinearLayout
        android:id="@+id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Previous Episode -->
        <ImageView
            android:id="@+id/btn_custom_prev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_player_glass"
            android:padding="12dp"
            android:src="@drawable/ic_previous"
            app:tint="#FFFFFF" />

        <!-- Rewind 10s -->
        <ImageView
            android:id="@+id/exo_rew"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_player_glass"
            android:padding="12dp"
            android:src="@drawable/exo_styled_controls_rewind"
            android:tint="#FFFFFF"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <!-- Replay from start -->
        <ImageView
            android:id="@+id/exo_replay"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_player_glass"
            android:padding="12dp"
            android:src="@drawable/ic_refresh"
            app:tint="#FFFFFF"
            tools:ignore="ContentDescription" />

        <!-- Play / Pause FAB - M3 Expressive -->
        <ImageView
            android:id="@+id/exo_play_pause"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shape_player_fab"
            android:elevation="6dp"
            android:padding="18dp"
            android:src="@drawable/exo_styled_controls_play"
            android:tint="?attr/colorOnPrimary"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <!-- Fast Forward 10s -->
        <ImageView
            android:id="@+id/exo_ffwd"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_glass"
            android:padding="12dp"
            android:src="@drawable/exo_styled_controls_fastforward"
            android:tint="#FFFFFF"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <!-- Next Episode -->
        <ImageView
            android:id="@+id/btn_custom_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_player_glass"
            android:padding="12dp"
            android:src="@drawable/ic_next"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- ======================== SKIP INTRO BUTTON ======================== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip_intro"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/player_skip_intro"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        app:icon="@drawable/exo_styled_controls_fastforward"
        app:iconTint="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="#AAFFFFFF"
        tools:visibility="visible" />

    <!-- ======================== PROGRESS BAR ======================== -->
    <androidx.media3.ui.DefaultTimeBar
        android:id="@+id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/exo_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ======================== BOTTOM BAR ======================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/exo_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_player_glass"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Time position -->
        <TextView
            android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="01:23:45" />

        <TextView
            android:id="@+id/tv_time_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="·"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/exo_position"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Time duration -->
        <TextView
            android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_time_separator"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="02:07:30" />

        <!-- Lock controls -->
        <ImageView
            android:id="@+id/btn_exo_lock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/exo_styled_controls_lock"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_exo_picture_in_picture"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <!-- Picture in Picture -->
        <ImageView
            android:id="@+id/btn_exo_picture_in_picture"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/exo_styled_controls_picture_in_picture"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_exo_aspect_ratio"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <!-- Aspect Ratio -->
        <ImageView
            android:id="@+id/btn_exo_aspect_ratio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/exo_styled_controls_aspect_ratio"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/exo_settings"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <!-- Settings -->
        <ImageView
            android:id="@+id/exo_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/exo_styled_controls_settings"
            android:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Unlock button (shown when locked) -->
    <ImageView
        android:id="@+id/btn_exo_unlock"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_player_glass"
        android:padding="12dp"
        android:src="@drawable/exo_styled_controls_unlock"
        android:tint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription,PrivateResource,UseAppTint"
        tools:visibility="visible" />

    <!-- Group for locking all controls except unlock button -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_controls_lock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:constraint_referenced_ids="ll_top_bar,ll_torrent_info,exo_center_controls,exo_progress,exo_bottom_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>